NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://wedesygn.com,https://www.wedesygn.com,https://wedesygn.vercel.app,https://wedesygn-backend.vercel.app,https://wedesygn-backend.onrender.com
DB_HOST=hostname
DB_PORT=port
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
ADMIN_API_KEY=your_private_admin_key
MAIL_TO=hello@wedesygn.com,wedesygnofficial@gmail.com
MAIL_FROM=hello@wedesygn.com

# Optional but recommended: send through the mailbox that owns MAIL_FROM instead of PHP mail().
# Google Workspace: smtp.gmail.com, port 465 (ssl) with an App Password. Leave SMTP_HOST empty to use PHP mail().
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_USER=hello@wedesygn.com
# SMTP_PASSWORD=your_app_password
